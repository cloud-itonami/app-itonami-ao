"ao_review_probe.py - no_agent measurement for the ao review paths.\n\nMeasures the ao organism review branches on api.murakumo.cloud LIVE:\n\n  case N (normal):    short answer well inside the token cap\n                      -> expect review_triggered=False (one call)\n  case L (near-limit):draft capped (max_tokens small so the draft hits it)\n                      -> expect review_triggered=True, record reviewed\n\nPer organism (ao/usagi, ao/kame) we record:\n  http_ok, organism field, members, review_triggered, reviewed,\n  completion_tokens vs max_tokens (cap-hit), wall ms.\n\nRules (AGENTS.md 8-questions):\n  - A call that could not run (network, 5xx) is UNMEASURED, not a failure\n    of the review branch. It still counts in ledger as its own line.\n  - The script holds the judgment: agent only reads this output.\n  - Append-only ledger: ~/.hermes/profiles/usagi-verify/workspace/ao-review-ledger.jsonl\n\nstdout format: MEASURE<TAB>key<TAB>value lines (machine readable).\n"
(import json)
(import os)
(import time)
(import urllib.request)
(import urllib.error)
(setv _ENV ((. os.path expanduser) "~/.hermes/profiles/usagi-verify/.env"))
(when ((. os.path exists) _ENV) (for [line (open _ENV)] (setv line (line.strip)) (when (and line (not (line.startswith "#")) (in "=" line)) (setv #(k _ v) (line.partition "=")) ((. os.environ setdefault) (k.strip) ((. ((. (v.strip) strip) "\"") strip) "'")))))
(setv BASE_URL "https://api.murakumo.cloud/v1/chat/completions")
(setv LEDGER ((. os.path expanduser) "~/.hermes/profiles/usagi-verify/workspace/ao-review-ledger.jsonl"))
(setv ORGANISMS ["ao/usagi" "ao/kame"])
(setv CASE_NORMAL {"messages" [{"role" "user"  "content" "Reply with exactly: OK"}]  "max_tokens" 256})
(setv CASE_NEAR_LIMIT {"messages" [{"role" "user"  "content" "Count from 1 to 400, comma separated, no spaces."}]  "max_tokens" 40})
(defn _auth_headers [] "Bearer when a key is available (cron runner env may differ from an\n    interactive shell where the gateway answers authless)." (setv key (or ((. os.environ get) "MURAKUMO_API_KEY") ((. os.environ get) "MURAKUMO_API_TOKEN"))) (return (if key {"authorization" f"Bearer {key}"} {})))
(defn call [model case [timeout 180]] (setv body ((. (json.dumps {"model" model  "stream" False  #** case}) encode))) (setv req ((. urllib.request Request) BASE_URL :data body :method "POST" :headers {"content-type" "application/json"  #** (_auth_headers)})) (setv t0 (time.time)) (try (with [resp ((. urllib.request urlopen) req :timeout timeout)] (setv data (json.loads ((. (resp.read) decode)))) (return {"http_ok" True  "status" resp.status  "ms" (int (* (- (time.time) t0) 1000))  "data" data})) (except [e (. urllib.error HTTPError)] (setv detail "") (try (setv detail (cut ((. (e.read) decode)) 500)) (except [Exception])) (return {"http_ok" False  "status" e.code  "ms" (int (* (- (time.time) t0) 1000))  "error" detail})) (except [e Exception] (return {"http_ok" False  "status" None  "ms" (int (* (- (time.time) t0) 1000))  "error" (cut (str e) 200)}))))
(defn extract [r] "Pull the measured fields out of a live response." (when (not (get r "http_ok")) (return {"unmeasured" True  "status" (get r "status")  "error" (r.get "error" "")})) (setv d (get r "data")) (setv m (or (d.get "murakumo" {}) {})) (setv u (or (d.get "usage" {}) {})) (return {"unmeasured" False  "organism" (m.get "organism")  "members" (m.get "members")  "review_triggered" (m.get "review_triggered")  "reviewed" (m.get "reviewed")  "completion_tokens" (u.get "completion_tokens")  "max_tokens" (r.get "max_tokens")  "finish" ((. (get (or (d.get "choices") [{}]) 0) get) "finish_reason")  "ms" (get r "ms")}))
(defn main [] (setv rows []) (for [org ORGANISMS] (for [#(case_name case) #(#("normal" CASE_NORMAL) #("near_limit" CASE_NEAR_LIMIT))] (setv r (call org case)) (setv (get r "max_tokens") (get case "max_tokens")) (setv x (extract r)) (setv row {"ts" (time.strftime "%Y-%m-%dT%H:%M:%S%z")  "organism" org  "case" case_name  #** x}) (rows.append row) (time.sleep 2))) (os.makedirs ((. os.path dirname) LEDGER) :exist_ok True) (with [f (open LEDGER "a")] (for [row rows] (f.write (+ (json.dumps row :ensure_ascii False) "\n")))) (for [row rows] (if (row.get "unmeasured") (do (print f"MEASURE\t{(get row "organism")}/{(get row "case")}\tUNMEASURED status={(row.get "status")} err={(cut (row.get "error" "") 60)}")) (do (print f"MEASURE\t{(get row "organism")}/{(get row "case")}\ttriggered={(get row "review_triggered")} reviewed={(get row "reviewed")} members={(len (or (get row "members") []))} ctok={(get row "completion_tokens")} cap={(get row "max_tokens")} finish={(get row "finish")} ms={(get row "ms")}")))) (setv checks []) (for [row rows] (when (row.get "unmeasured") (checks.append f"WARN {(get row "organism")}/{(get row "case")}: UNMEASURED (not a branch failure)") (continue)) (setv key f"{(get row "organism")}/{(get row "case")}") (when (and (= (get row "case") "normal") (get row "review_triggered")) (checks.append f"FAIL {key}: normal-case review fired (expected one-call)")) (when (and (= (get row "case") "near_limit") (not (get row "review_triggered"))) (checks.append f"FAIL {key}: near-limit case did NOT trigger review")) (when (and (= (get row "case") "near_limit") (get row "review_triggered") (is (get row "reviewed") False)) (checks.append f"NOTE {key}: review fired but its answer was not adopted (draft kept)"))) (for [c checks] (print f"CHECK\t{c}")) (setv ok (not (any (gfor c checks (c.startswith "FAIL"))))) (setv unmeasured (sum (gfor row rows :if (row.get "unmeasured") 1))) (print f"STATUS\tok={((. (str ok) lower))} measured={(- (len rows) unmeasured)} unmeasured={unmeasured}") (return (if ok 0 1)))
(when (= __name__ "__main__") (raise (SystemExit (main))))
